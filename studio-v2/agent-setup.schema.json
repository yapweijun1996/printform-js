{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yapweijun1996.github.io/printform-js/studio-v2/agent-setup.schema.json",
  "title": "PrintForm Studio agent bootstrap manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "studio", "handoffPrompt", "requirements", "mcpServer", "clients", "procedure", "verification", "safety"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "printform-studio-agent-bootstrap" },
    "studio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "protocolVersion", "commandContractVersion", "humanGuide", "llmsText"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "protocolVersion": { "type": "string" },
        "commandContractVersion": { "type": "string" },
        "humanGuide": { "type": "string", "pattern": "^https://" },
        "llmsText": { "type": "string", "pattern": "^https://" }
      }
    },
    "handoffPrompt": { "type": "string", "minLength": 20 },
    "requirements": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "minimumVersion", "checkCommands"],
        "properties": {
          "id": { "type": "string" },
          "minimumVersion": { "type": "string" },
          "recommendedVersion": { "type": "string" },
          "checkCommands": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "mcpServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "transport", "command", "package", "args"],
      "properties": {
        "name": { "const": "chrome-devtools" },
        "transport": { "const": "stdio" },
        "command": { "const": "npx" },
        "package": { "type": "string", "pattern": "^chrome-devtools-mcp@[0-9]" },
        "args": { "type": "array", "minItems": 2, "items": { "type": "string" } }
      }
    },
    "clients": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex", "claudeCode"],
      "properties": {
        "codex": { "$ref": "#/$defs/client" },
        "claudeCode": { "$ref": "#/$defs/client" }
      }
    },
    "procedure": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mode", "instruction"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "mode": { "enum": ["read-only", "human-confirmation", "write-user-config", "human-action", "mcp-call"] },
          "instruction": { "type": "string", "minLength": 10 },
          "mcpTool": { "type": "string" },
          "arguments": { "type": "object" },
          "expectedToolCount": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredMcpTools", "requiredStudioTools", "expectedProtocolVersion", "expectedCommandContractVersion", "expectedWebMcpToolCount"],
      "properties": {
        "requiredMcpTools": { "type": "array", "minItems": 3, "items": { "type": "string" } },
        "requiredStudioTools": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "expectedProtocolVersion": { "type": "string" },
        "expectedCommandContractVersion": { "type": "string" },
        "expectedWebMcpToolCount": { "type": "integer", "minimum": 1 }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isolatedTemporaryProfileRequired", "dailyChromeAutoConnectAllowed", "realErpDataDefault", "mutationRequiresPreview", "revisionConflictPolicy", "humanProductionExportRequired", "agentMustCompleteLayoutReview"],
      "properties": {
        "isolatedTemporaryProfileRequired": { "const": true },
        "dailyChromeAutoConnectAllowed": { "const": false },
        "realErpDataDefault": { "const": "deny" },
        "mutationRequiresPreview": { "const": true },
        "revisionConflictPolicy": { "const": "fail-closed" },
        "humanProductionExportRequired": { "const": true },
        "agentMustCompleteLayoutReview": { "const": true }
      }
    }
  },
  "$defs": {
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "detectCommand", "inspectCommand", "removeCommand", "installCommand", "configScope", "restartInstruction"],
      "properties": {
        "displayName": { "type": "string" },
        "detectCommand": { "type": "string" },
        "inspectCommand": { "type": "string" },
        "removeCommand": { "type": "string" },
        "installCommand": { "type": "string" },
        "configScope": { "const": "user" },
        "restartInstruction": { "type": "string", "minLength": 10 }
      }
    }
  }
}
